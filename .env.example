# Copy to .env and fill in. .env is git-ignored; never commit real keys.
# The entry points (evaluate.py, evaluate_agent.py, simulate.py, app.py) load .env
# automatically via env.py; real environment variables still take precedence.
# Without a .env everything runs against the fake model / local authz backend.

# --- LLM (DeepSeek, OpenAI-compatible) ---------------------------------------
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_PRICE_IN_PER_M=0.28    # price recorded in another project; check the DeepSeek site
LLM_PRICE_OUT_PER_M=0.42

# --- Embeddings (Alibaba Bailian text-embedding-v4, OpenAI-compatible) -------
EMBED_MODEL=text-embedding-v4
EMBED_BASE_URL=            # Bailian OpenAI-compatible endpoint (see the Bailian console)
EMBED_API_KEY=

# --- Authorization ------------------------------------------------------------
AUTHZ_BACKEND=local        # switch to openfga once the server is running
OPENFGA_API_URL=http://localhost:8080

# --- Demo clock ---------------------------------------------------------------
DEMO_NOW=2026-10-14T14:05:00+08:00

# --- Audit --------------------------------------------------------------------
# HMAC key for the signed checkpoints. When unset a random key is generated and
# stored in .cache/audit.key (git-ignored, never in state/).
AUDIT_HMAC_KEY=
